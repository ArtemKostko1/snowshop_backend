generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  name        String
  roleId      Int
  sexId       Int?
  age         Int?
  phoneNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  role       Role     @relation(fields: [roleId], references: [id])
  sex        Sex?     @relation(fields: [sexId], references: [id])
  orders     Order[]
}

model Role {
  id    Int      @id @default(autoincrement())
  name  String
  value String
  users User[]
}

model Sex {
  id    Int      @id @default(autoincrement())
  name  String
  value String
  users User[]
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(255)
  price         Float
  categoryId    Int
  brandId       Int
  size          String?  @db.VarChar(100)
  article       String   @db.VarChar(100)
  articleRoute  String   @db.VarChar(100) @default("")
  inStock       Boolean
  description   String   @db.Text
  internalCode  String   @db.VarChar(100)
  images        Json     @default("[]")
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category      Category @relation(fields: [categoryId], references: [id])
  brand         Brand    @relation(fields: [brandId], references: [id])
  orderItems    OrderItem[]
}

model Category {
  id    Int     @id @default(autoincrement())
  name  String  @db.VarChar(255)
  value String  @db.VarChar(255) @default("")

  products Product[]
}

model Brand {
  id    Int     @id @default(autoincrement())
  name  String  @db.VarChar(255)

  products Product[]
}

model Order {
  id            Int       @id @default(autoincrement())
  email         String    @db.VarChar(255)
  phoneNumber   String    @db.VarChar(100)
  userId        Int?
  status        String    @db.VarChar(50) @default("pending")
  totalPrice    Float
  delivery      String    @db.Text
  paymentMethod String    @db.Text
  comment       String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orderItems    OrderItem[]
  user          User?     @relation(fields: [userId], references: [id])
}

model OrderItem {
  id            Int       @id @default(autoincrement())
  orderId       Int
  productId     Int?
  quantity      Int
  price         Float
  productName     String    @db.VarChar(255)
  productArticle  String    @db.VarChar(255) @default("")
  productInternalCode  String    @db.VarChar(100)
  productSize     String?   @db.VarChar(100)
  productImage    String    @default("")

  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
}
